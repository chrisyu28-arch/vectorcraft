+# The web shell cannot start without this pinned fallback. Check before building and after
+# copying, so missing or modified assets never produce an apparently valid release ZIP.
+HANGUL_DIR="fonts/2c76254f6fc379fd"
+verify_hangul_assets() {
+  local root="$1" f
+  [ -f "$root/fonts/manifest.txt" ] || { echo "error: required fonts/manifest.txt missing" >&2; exit 1; }
+  cmp -s "$HERE/hangul-fonts-manifest.txt" "$root/fonts/manifest.txt" || {
+    echo "error: fonts/manifest.txt differs from the pinned Hangul manifest" >&2; exit 1;
+  }
+  for f in NotoSansCJKsc-Regular.otf OFL.txt; do
+    [ -f "$root/$HANGUL_DIR/$f" ] || { echo "error: required $HANGUL_DIR/$f missing" >&2; exit 1; }
+  done
+  [ "$(sha256 "$root/$HANGUL_DIR/NotoSansCJKsc-Regular.otf")" = "2c76254f6fc379fddfce0a7e84fb5385bb135d3e399294f6eeb6680d0365b74b" ] || {
+    echo "error: Korean font SHA-256 mismatch" >&2; exit 1;
+  }
+  [ "$(sha256 "$root/$HANGUL_DIR/OFL.txt")" = "cc0eaf2711e2af9e233ef8d4d2ead8481ae3ee51065a5dbe254578d5868aa40e" ] || {
+    echo "error: Korean font licence SHA-256 mismatch" >&2; exit 1;
+  }
+}
+[ -n "${PHOTOCRAFT_WEB_FONTS_DIR:-}" ] || {
+  echo "error: PHOTOCRAFT_WEB_FONTS_DIR is required for the web package" >&2; exit 1;
+}
+verify_hangul_assets "$PHOTOCRAFT_WEB_FONTS_DIR"
+
