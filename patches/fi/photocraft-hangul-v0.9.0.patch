diff --git a/crates/ui-egui/src/hangul_font.rs b/crates/ui-egui/src/hangul_font.rs
new file mode 100644
index 0000000..0bee249
--- /dev/null
+++ b/crates/ui-egui/src/hangul_font.rs
@@ -0,0 +1,128 @@
+//! Pinned, same-site Hangul fallback for the web package. Bytes stay outside the wasm.
+use std::sync::{Arc, PoisonError};
+
+use egui::{FontData, FontDefinitions};
+use sha2::{Digest, Sha256};
+
+pub const FAMILY: &str = "Noto Sans CJK SC";
+pub const URL: &str = "fonts/2c76254f6fc379fd/NotoSansCJKsc-Regular.otf";
+pub const SHA256: &str = "2c76254f6fc379fddfce0a7e84fb5385bb135d3e399294f6eeb6680d0365b74b";
+const BYTE_LEN: usize = 16_437_364;
+const UI_NAME: &str = "web-hangul-fallback";
+const MANIFEST: &str = include_str!("../../../packaging/web/hangul-fonts-manifest.txt");
+
+/// Verify downloaded bytes locally, independently of browser SRI and the sandbox origin.
+pub fn verify(bytes: &[u8]) -> Result<(), String> {
+    if bytes.len() != BYTE_LEN || format!("{:x}", Sha256::digest(bytes)) != SHA256 {
+        return Err("Korean font integrity check failed".into());
+    }
+    Ok(())
+}
+
+/// Registers the verified font with both the document engine and this egui context.
+pub fn install(ctx: &egui::Context, bytes: Vec<u8>) -> Result<(), String> {
+    verify(&bytes)?;
+    let (fonts, skipped) = crate::served_fonts::parse_manifest(MANIFEST);
+    if !skipped.is_empty() || fonts.len() != 1 {
+        return Err("Korean font manifest is invalid".into());
+    }
+    crate::served_fonts::add_fonts(&fonts);
+    let added = photocraft_text::shared().lock().unwrap_or_else(PoisonError::into_inner).fonts.register_font_data(bytes.clone());
+    if !added.iter().any(|name| name == FAMILY) {
+        return Err("Korean font could not be registered".into());
+    }
+    ctx.data_mut(|data| data.insert_temp(egui::Id::new(UI_NAME), Arc::new(FontData::from_owned(bytes))));
+    crate::theme::install_fonts(ctx);
+    Ok(())
+}
+
+/// Reused on every theme/language font installation; the cached bytes belong to the context.
+pub(crate) fn append(ctx: &egui::Context, fonts: &mut FontDefinitions) {
+    let Some(data) = ctx.data(|data| data.get_temp::<Arc<FontData>>(egui::Id::new(UI_NAME))) else { return };
+    fonts.font_data.insert(UI_NAME.into(), data);
+    for stack in fonts.families.values_mut() {
+        if !stack.iter().any(|name| name == UI_NAME) {
+            stack.push(UI_NAME.into());
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use egui::{FontFamily, FontId};
+    use photocraft_engine::prefs::UiFontSize;
+
+    #[test]
+    fn rejects_untrusted_bytes_before_font_registration() {
+        assert!(verify(b"not a font").is_err());
+        assert!(install(&egui::Context::default(), vec![0; 32]).is_err());
+    }
+
+    #[test]
+    fn manifest_pins_the_same_site_original_and_korean_script() {
+        let (fonts, skipped) = crate::served_fonts::parse_manifest(MANIFEST);
+        assert!(skipped.is_empty());
+        assert_eq!(fonts.len(), 1);
+        assert_eq!(fonts[0].family, FAMILY);
+        assert_eq!(fonts[0].file, URL);
+        assert!(fonts[0].scripts.iter().any(|script| script == "Kore"));
+        assert!(fonts[0].integrity.is_some());
+        assert!(!URL.starts_with('/') && !URL.contains("://") && !URL.contains(".."));
+    }
+
+    #[test]
+    #[ignore = "requires PHOTOCRAFT_HANGUL_FONT; the web release job runs this explicitly"]
+    fn pinned_font_covers_all_hangul_and_survives_reinstallation() {
+        let path = std::env::var("PHOTOCRAFT_HANGUL_FONT").expect("set PHOTOCRAFT_HANGUL_FONT to the pinned original OTF");
+        let bytes = std::fs::read(path).expect("read the pinned original");
+        verify(&bytes).expect("original SHA-256");
+        let mut covered = 0;
+        for cp in 0xAC00..=0xD7A3 {
+            let c = char::from_u32(cp).unwrap();
+            // This is the application's skrifa cmap path, with no system-font lookup.
+            assert_eq!(photocraft_text::scripts::covering_face(&bytes, c), Some(0), "U+{cp:04X}");
+            covered += 1;
+        }
+        assert_eq!(covered, 11_172);
+        let mut corrupted = bytes.clone();
+        corrupted[100] ^= 1;
+        assert!(verify(&corrupted).is_err(), "same-length corruption must fail");
+        let ctx = egui::Context::default();
+        install(&ctx, bytes).expect("register in the UI and document database");
+        assert!(photocraft_text::shared().lock().unwrap().fonts.families().iter().any(|name| name == FAMILY));
+        assert!(photocraft_text::served::families().iter().any(|name| name == FAMILY));
+        for size in [UiFontSize::Tiny, UiFontSize::Medium, UiFontSize::Large, UiFontSize::Small] {
+            crate::theme::set_ui_font_size(&ctx, size);
+            // Language changes use the same installation entry point.
+            crate::theme::install_fonts_with(
+                &ctx,
+                crate::cjk_fonts::Sources {
+                    locale: || None,
+                    files: |_| vec![],
+                    last_resort: Vec::new,
+                    scripts: |_| vec![],
+                    covers: photocraft_text::scripts::covering_face,
+                    embedded: crate::cjk_fonts::no_embedded,
+                },
+            );
+            for _ in 0..2 {
+                ctx.run_ui(Default::default(), |ui| {
+                    ui.label("한글 파일 레이어");
+                })
+                .textures_delta
+                .clear();
+            }
+            let definitions = ctx.fonts(|f| f.definitions().clone());
+            for (family, stack) in &definitions.families {
+                assert_eq!(stack.iter().filter(|name| *name == UI_NAME).count(), 1);
+                for c in "한글 파일 레이어".chars().filter(|c| !c.is_whitespace()) {
+                    assert!(ctx.fonts_mut(|f| f.has_glyph(&FontId::new(13.0, family.clone()), c)), "{family:?}: {c}");
+                }
+            }
+            let id = FontId::new(13.0, FontFamily::Proportional);
+            assert!(ctx.fonts_mut(|f| (0xAC00..=0xD7A3).all(|cp| f.has_glyph(&id, char::from_u32(cp).unwrap()))));
+        }
+        println!("Pinned Noto Sans CJK SC: SHA-256 verified; skrifa cmap 11172/11172; all egui families and reinstall checks passed");
+    }
+}
